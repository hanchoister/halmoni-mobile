# Copy this file to .env.local and fill in your real values.
# Find both in Supabase: Dashboard -> Project Settings -> Data API (URL)
# and Project Settings -> API Keys (publishable key, starts with sb_publishable_).
# Use ONLY the publishable key here -- never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Google OAuth client IDs from Google Cloud Console -> APIs & Services -> Credentials.
# Required for "Continue with Google":
#   WEB client id is what Expo Go uses (and is the one Supabase verifies against).
#   IOS / ANDROID client ids are used by standalone / dev builds; safe to leave blank
#   until you build outside Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
